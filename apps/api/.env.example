# Copia este archivo a .env y completa con tus valores reales. NUNCA subas .env a git.

# Mongo Atlas: Database Access > crea un usuario; Network Access > agrega tu IP (o 0.0.0.0/0 en desarrollo)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/fitness-recomp?retryWrites=true&w=majority

# Genera uno fuerte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=30d

PORT=4000
NODE_ENV=development

# URL del frontend permitida por CORS
CLIENT_ORIGIN=http://localhost:5173

# Consíguela en https://aistudio.google.com/apikey
# Sin esta key, el server arranca normal, pero el Chat y la generación de
# Logros responden 503 hasta que la agregues.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.0-flash
